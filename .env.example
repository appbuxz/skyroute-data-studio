# Travelport API credentials (server-side only)
# Fill these only after Travelport approves API access.
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=
# Set either Access Group OR PCC+GDS. Access Group wins if both are set.
TRAVELPORT_ACCESS_GROUP=
# Full format: <assigned PCC>_<assigned GDS>, not a bare PCC.
TRAVELPORT_PCC=
